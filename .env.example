# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=production

# Where the database lives. On a host with a persistent disk, point this at the disk (e.g. /var/data).
# DATA_DIR=./data

# Set to 1 when the site sits behind a proxy/host that terminates HTTPS (Render, Railway, Fly, nginx...)
# TRUST_PROXY=1

# Contact form: messages are always saved. To ALSO get them by email, fill in SMTP + OWNER_EMAIL.
# (Gmail: smtp.gmail.com, port 587, use an App Password.)
OWNER_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="LifeBox <you@example.com>"

# Optional: lets you read messages at /api/admin/messages with header  x-admin-token: <value>
ADMIN_TOKEN=
