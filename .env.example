# Copy to .env for local use. On Vercel add these under Settings > Environment Variables.

# Required: PostgreSQL connection string (Neon gives you this).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Contact form: messages are always saved. To ALSO get them by email, fill in these.
# (Gmail: smtp.gmail.com, port 587, use an App Password.)
OWNER_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="LifeBox <you@example.com>"

# Optional: read messages at /api/admin/messages with header  x-admin-token: <value>
ADMIN_TOKEN=
